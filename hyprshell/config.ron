// Edit with `hyprshell config edit`
(
    version: 3,
    windows: (
        scale: 5,
        items_per_row: 5,
        overview: None,
        switch: (
            modifier: "alt",
            key: "Tab",
            filter_by: [
                current_monitor,
            ],
            switch_workspaces: true,
            exclude_special_workspaces: "special:.*",
        ),
        switch_2: None,
    ),
)
